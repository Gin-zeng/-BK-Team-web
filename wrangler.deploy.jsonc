// 唯一生产站的部署配置：www.jxlq.top（自有 Cloudflare 账号）
//   一键命令：npm run deploy:cf
//   D1：mech-hoops-db / R2：mech-hoops-media（完整步骤见 docs/部署手册.md）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mechanical-basketball",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mech-hoops-db",
      "database_id": "e44acb24-9672-4ea7-8b87-706c281a9356"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mech-hoops-media"
    }
  ],
  "routes": [{ "pattern": "www.jxlq.top", "custom_domain": true }],
  "observability": { "enabled": true }
}
